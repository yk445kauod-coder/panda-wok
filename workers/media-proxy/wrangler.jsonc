{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "panda-wok-media",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  // Secrets (set with `wrangler secret put`, never in this file):
  //   DBBYTE_KEY   — the `dbk_...` API key for the media bucket.
  "vars": {
    // DBByte REST gateway. Not a secret; the bucket and key are.
    "DBBYTE_ENDPOINT": "https://api.dbbyte.com",
    // The one bucket this worker reads from.
    "DBBYTE_BUCKET": "panda-wok-media",
    // The site's own origin, so only the site (and the browser) may use the proxy.
    "SITE_ORIGIN": "https://panda-wok.pages.dev"
  }
}
