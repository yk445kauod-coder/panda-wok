# Panda Wok :: environment
# Public values, safe to ship in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://xjbtsryidznsxqlynmfa.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Server-only. Never import this in a Client Component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public origin used for canonical URLs, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional AI provider (server-only). Selects the adapter used as the primary
# model. When unset, the platform uses the deterministic database-grounded
# provider instead of failing. Each adapter reads its OWN scoped env block
# first, the generic AI_* block second (so primary and fallback credentials can
# live side-by-side, and the model is never the source of truth — it only
# rephrases data pulled from the live database).
AI_PROVIDER_KIND=openrouter
# Generic fallback block (used by any provider without a scoped value):
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_FALLBACK_MODEL=
# Optional display names for the AI centre (defaults to the kind)..
AI_OPENROUTER_NAME=
AI_OPENROUTER_MODEL=
AI_OPENROUTER_BASE_URL=
AI_OPENROUTER_API_KEY=
AI_CLOUDFLARE_NAME=
AI_CLOUDFLARE_MODEL=
AI_CLOUDFLARE_BASE_URL=
AI_CLOUDFLARE_API_KEY=
AI_POLLINATIONS_NAME=
AI_POLLINATIONS_MODEL=
AI_POLLINATIONS_BASE_URL=
AI_POLLINATIONS_API_KEY=
AI_GEMINI_NAME=
AI_GEMINI_MODEL=
AI_GEMINI_BASE_URL=
AI_GEMINI_API_KEY=
AI_ANTHROPIC_NAME=
AI_ANTHROPIC_MODEL=
AI_ANTHROPIC_BASE_URL=
AI_ANTHROPIC_API_KEY=
AI_OPENAI_COMPATIBLE_NAME=
AI_OPENAI_COMPATIBLE_MODEL=
AI_OPENAI_COMPATIBLE_BASE_URL=
AI_OPENAI_COMPATIBLE_API_KEY=

# Optional transactional email. Unset means broadcasts stay in-app only.
RESEND_API_KEY=
EMAIL_FROM=
