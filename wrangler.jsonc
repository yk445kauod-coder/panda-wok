{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "panda-wok",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    // Node.js APIs are required by the Supabase SSR client and the App Router.
    "nodejs_compat",
    // Next.js fetches remote images / API URLs; keep fetch semantics strict.
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Workers AI runs in-account with no API key; the assistant prefers it.
  "ai": {
    "binding": "AI"
  },
  "vars": {
    // Remote fallback for the AI binding, served by the dedicated
    // panda-wok-ai-api worker. The app's `cloudflare` provider appends
    // /ai/run/<model>, which that worker implements verbatim, so the binding
    // stays primary and this only takes over if the binding is unavailable.
    // The matching AI_CLOUDFLARE_API_KEY is a secret (the shared AI token).
    "AI_CLOUDFLARE_BASE_URL": "https://panda-wok-ai-api.yk445kauod.workers.dev",
    "AI_CLOUDFLARE_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct"
  },
  "observability": {
    "enabled": true
  }
}
