{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "panda-wok",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AI_CLOUDFLARE_BASE_URL": "https://panda-wok-ai-api.yk445kauod.workers.dev",
    "AI_CLOUDFLARE_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
    "OPS_HUB_URL": "https://panda-wok-ops-hub.yk445kauod.workers.dev"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "9275068b465c4518b64ad36e24b876b5"
    },
    {
      "binding": "NEXT_TAG_CACHE_KV",
      "id": "41e3b5120d8d48c08c04cedca8082e33"
    }
  ],
  "d1_databases": [
    {
      "binding": "D1_DB",
      "database_name": "panda-wok",
      "database_id": "b093a40f-3ad7-498a-bad4-5abbfc4dfce5"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "panda-wok-media",
      "preview_bucket_name": "panda-wok-media"
    },
    {
      "binding": "ARTIFACTS_BUCKET",
      "bucket_name": "panda-wok-artifacts",
      "preview_bucket_name": "panda-wok-artifacts"
    }
  ]
}
