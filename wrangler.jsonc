{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "panda-wok",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    // Node.js APIs are required by the Supabase SSR client and the App Router.
    "nodejs_compat",
    // Next.js fetches remote images / API URLs; keep fetch semantics strict.
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Workers AI runs in-account with no API key; the assistant prefers it.
  "ai": {
    "binding": "AI"
  },
  "vars": {
    // Remote fallback for the AI binding, served by the dedicated
    // panda-wok-ai-api worker. The app's `cloudflare` provider appends
    // /ai/run/<model>, which that worker implements verbatim, so the binding
    // stays primary and this only takes over if the binding is unavailable.
    // The matching AI_CLOUDFLARE_API_KEY is a secret (the shared AI token).
    "AI_CLOUDFLARE_BASE_URL": "https://panda-wok-ai-api.yk445kauod.workers.dev",
    "AI_CLOUDFLARE_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct"
  },
  "observability": {
    "enabled": true
  },

  // Cross-isolate data cache. The public data layer wraps its reads in
  // `cachedPublic` (Next's `unstable_cache`), which is a no-op without these
  // namespaces — the site renders uncached but correctly. Bound, one Supabase
  // read is reused across requests instead of one per visitor. Both degrade
  // safely if the binding ever disappears (the incremental cache is wrapped in
  // `src/lib/cache/incremental-cache.ts`; the tag cache guards internally).
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "9275068b465c4518b64ad36e24b876b5" },
    { "binding": "NEXT_TAG_CACHE_KV", "id": "41e3b5120d8d48c08c04cedca8082e33" }
  ]
}
